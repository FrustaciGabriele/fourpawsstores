<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fourpawsstores.view.AddProductControllerGrafico"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <BorderPane  >
            <left>
                <ImageView fx:id="Back" fitHeight="30" fitWidth="30" onMouseClicked="#goBack"/>
            </left>
            <center>
                 <Label fx:id="title" style="-fx-font-size: 20px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"  BorderPane.alignment="CENTER" alignment="CENTER"/>
            </center>
        </BorderPane>
    </top>
    <center>
        <HBox alignment="TOP_CENTER">
            <padding>
                <Insets bottom="10.0" left="60.0" right="10.0" top="30.0"/>
            </padding>
          <GridPane hgap="10" vgap="10" >
                <columnConstraints>
                    <ColumnConstraints percentWidth="85"/>
                 </columnConstraints>
                 <Label  text="Nome:" GridPane.rowIndex="0"  />
                <TextField fx:id="prodName" promptText="Inserisci nome prodotto"  GridPane.rowIndex="1"/>
                <Label text="Descrizione" GridPane.rowIndex="2"/>
                <TextArea fx:id="prodDescription" promptText="Inserisci descrizione prodotto" wrapText="true" GridPane.rowIndex="3" GridPane.rowSpan="3"/>
                <HBox GridPane.rowIndex="6">
                    <VBox>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <Label text="Prezzo"/>
                        <TextField fx:id="prodPrice" promptText="00.00"/>
                    </VBox>
                    <Button text="Aggiungi Immagine" onAction="#addImg" prefHeight="50" wrapText="true" alignment="CENTER"/>
                </HBox>

        </GridPane>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets bottom="60.0" />
            </padding>
        <Button text="Aggiungi prodotto" onAction="#addProduct" />
        </HBox>
    </bottom>
</BorderPane>
