<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.fourpawsstores.view.LoginView"
            stylesheets="/LoginStyles.css"
            styleClass="left-bk">
    <top>
        <VBox spacing="20">
            <padding>
                <Insets top="30" right="30" bottom="10" left="30"/>
            </padding>
            <HBox>
                <Button text="Cambia Grafica" onMouseClicked="#changeUI"/>
            </HBox>
            <HBox>
                <ComboBox fx:id="demo" prefWidth="110" value="Mode: Final">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Mode: Final"/>
                            <String fx:value="Mode: Demo"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

        </VBox>
    </top>
    <center>
    <VBox alignment="CENTER">
    <VBox alignment="CENTER" spacing="20" >
        <padding>
            <Insets top="100" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="Login" styleClass="title-label"/>

        <TextField fx:id="textFieldUsername" promptText="Username" styleClass="text-field" onAction="#handleEnter"/>
        <PasswordField fx:id="textFieldPassword" promptText="Password" styleClass="text-field" onAction="#handleEnter"/>

        <Button text="Login" onAction="#login" styleClass="login-button"/>


    </VBox>
    </VBox>
    </center>

</BorderPane>
