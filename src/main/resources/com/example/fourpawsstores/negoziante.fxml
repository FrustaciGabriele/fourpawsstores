<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fourpawsstores.view.CatalogueStoreControllerGrafico"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="/catalogo.css">
    <top>
        <BorderPane  AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <left>
            <ImageView fx:id="Add" fitHeight="30" fitWidth="30" onMouseClicked="#addProduct"/>
            </left>
            <center>
            <Label fx:id="titleC" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black; -fx-alignment: center;" HBox.hgrow="ALWAYS" BorderPane.alignment="CENTER"/>
            </center>
        </BorderPane>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" AnchorPane.topAnchor="60" AnchorPane.bottomAnchor="80" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <VBox fx:id="productList" spacing="15" >
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="65.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <ImageView fx:id="Iprofilo" fitHeight="100.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#goToProfile"/>
            <ImageView fx:id="Icatalogo" fitHeight="100.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true"/>
            <ImageView fx:id="Iordini" fitHeight="100.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#goToOrders"/>

        </HBox>
    </bottom>
</BorderPane>
