<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fourpawsstores.view.SearchControllerGrafico"
            prefHeight="400.0" prefWidth="600.0">
    <top>
    <HBox fx:id="topControls" spacing="10.0" BorderPane.alignment="CENTER">
        <TextField fx:id="address" promptText="Inserisci l'indirizzo" HBox.hgrow="ALWAYS" onAction="#handleEnter" />
        <ImageView  fx:id="Icerca" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#FindAddress">
        </ImageView>
    </HBox>
    </top>
    <center>
        <WebView fx:id="webViewMap" BorderPane.alignment="CENTER"/>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="65.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <ImageView fx:id="Iprofilo" fitHeight="100.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#SeeProfile"/>
            <ImageView fx:id="Imappa" fitHeight="100.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true"/>
            <ImageView fx:id="Iordini" fitHeight="100.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#openOrders"/>

        </HBox>
    </bottom>
</BorderPane>
