<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fourpawsstores.view.SearchControllerGrafico"
            prefHeight="400.0" prefWidth="600.0">
    <top>
    <HBox fx:id="topControls" spacing="10.0" BorderPane.alignment="CENTER">
        <TextField fx:id="address" promptText="Inserisci l'indirizzo" HBox.hgrow="ALWAYS" onAction="#handleEnter" />
        <ImageView  fx:id="Icerca" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#SearchStores">
        </ImageView>
    </HBox>
    </top>
    <center>
        <WebView fx:id="webViewMap" BorderPane.alignment="CENTER"/>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="65.0">

        </HBox>
    </bottom>
</BorderPane>
